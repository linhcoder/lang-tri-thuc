{$DOMAIN} {
    @preview {
        not path /api/* /colyseus/*
    }
    basic_auth @preview {
        staging {$STAGING_PASSWORD_HASH}
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        X-Frame-Options DENY
    }
    handle_path /api/* {
        reverse_proxy api:3000
    }
    handle_path /colyseus/* {
        reverse_proxy rooms:2567
    }
    handle_path /game/* {
        root * /srv/game
        file_server
    }
    handle {
        root * /srv/admin
        try_files {path} /index.html
        file_server
    }
}
