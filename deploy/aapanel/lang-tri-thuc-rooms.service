[Unit]
Description=Lang Tri Thuc private multiplayer rooms
After=network.target lang-tri-thuc-api.service

[Service]
Type=simple
User=langtri
Group=langtri
WorkingDirectory=/opt/lang-tri-thuc/current
EnvironmentFile=/etc/lang-tri-thuc/rooms.env
ExecStart=/www/server/nodejs/v24.16.0/bin/node /opt/lang-tri-thuc/current/apps/game-server/dist/game-server/src/main.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
