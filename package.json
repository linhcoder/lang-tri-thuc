{
  "name": "lang-tri-thuc",
  "private": true,
  "workspaces": [
    "apps/game-client",
    "apps/game-server",
    "apps/backend",
    "apps/admin"
  ],
  "scripts": {
    "server": "npm run start --workspace game-server",
    "server:build": "npm run build --workspace game-server",
    "test:server": "npm run test --workspace game-server",
    "web": "node tools/serve-web.cjs",
    "web:build": "node tools/build-web.cjs",
    "test:client": "node apps/game-client/tests/milestone01a.cjs && node --test apps/game-client/tests/network-lifecycle.cjs",
    "check:client": "tsc -p apps/game-client/tsconfig.json --skipLibCheck --strict --pretty false",
    "test:web": "node apps/game-client/tests/build-smoke.cjs",
    "test:m2": "node apps/game-client/tests/chapter-one-web.cjs",
    "test:assets": "node apps/game-client/tests/assets-web.cjs",
    "test:avatars": "node apps/game-client/tests/avatars-web.cjs",
    "test:speech": "node apps/game-client/tests/speech-web.cjs",
    "test:drag": "node apps/game-client/tests/drag-web.cjs",
    "test:zoom": "node apps/game-client/tests/zoom-web.cjs",
    "test:admin": "node apps/admin/tests/admin-web.cjs",
    "test:campaign": "node apps/game-client/tests/campaign-web.cjs",
    "api": "npm run start --workspace game-backend",
    "api:build": "npm run build --workspace game-backend",
    "test:api": "npm run test --workspace game-backend",
    "admin": "npm run dev --workspace game-admin",
    "admin:build": "npm run build --workspace game-admin",
    "local:stack": "node tools/local-stack.cjs",
    "test:stack": "node apps/game-client/tests/stack-web.cjs",
    "backup:local": "node tools/backup-mysql.cjs",
    "db:setup": "npm run api:build && node tools/setup-mysql.cjs",
    "test:mysql": "npm run api:build && node tools/test-mysql.cjs",
    "backup:sqlite": "node tools/backup-local.cjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
